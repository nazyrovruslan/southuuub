# SEO-данные и адрес сайта для метатегов (сервис shsites). Без них страница берёт заголовок и описание по умолчанию.
# NEXT_PUBLIC_SHSITES_URL=https://...
# NEXT_PUBLIC_SHSITES_API_KEY=...

# Яндекс.Метрика: любое непустое значение включает счётчик
NEXT_PUBLIC_ENABLE_METRIC=
